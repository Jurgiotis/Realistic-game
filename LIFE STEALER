<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shadow Provinces</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      overflow: hidden;
      background: #18291f;
      color: #efe7d1;
      font: 16px Georgia, serif;
      user-select: none;
    }
    canvas { display: block; }

    #title {
      position: fixed;
      inset: 0;
      z-index: 10;
      display: grid;
      place-items: center;
      background:
        linear-gradient(#1e351fdd, #10150fff),
        repeating-linear-gradient(45deg, #b8a66e 0 2px, transparent 2px 12px);
    }
    #title-panel {
      width: min(560px, calc(100% - 40px));
      padding: 42px;
      border: 2px solid #c9ad63;
      background: #171d18ef;
      text-align: center;
      box-shadow: 0 20px 70px #000;
    }
    h1 {
      margin: 0 0 12px;
      color: #f2d58a;
      letter-spacing: 5px;
    }
    button {
      margin-top: 12px;
      padding: 12px 24px;
      border: 1px solid #c9ad63;
      background: #26391f;
      color: #fff4c7;
      font: inherit;
      cursor: pointer;
    }

    #hud {
      position: fixed;
      inset: 0;
      pointer-events: none;
    }
    #mission {
      position: absolute;
      top: 18px;
      left: 18px;
      max-width: 330px;
      padding: 13px 16px;
      border-left: 3px solid #d7bb69;
      background: #152017dd;
    }
    #minimap {
      position: absolute;
      right: 18px;
      bottom: 18px;
      width: 170px;
      height: 170px;
      border: 2px solid #d7bb69;
      border-radius: 50%;
      background: #1a291e;
    }
    #prompt {
      position: absolute;
      left: 50%;
      bottom: 110px;
      padding: 9px 14px;
      border: 1px solid #d7bb69;
      background: #152017ee;
      transform: translateX(-50%);
      opacity: 0;
    }
    #prompt.visible { opacity: 1; }
  </style>
</head>
<body>
  <canvas id="game"></canvas>

  <div id="title">
    <div id="title-panel">
      <h1>SHADOW PROVINCES</h1>
      <p>
        Explore a feudal-inspired open world. Meet villagers, gather supplies,
        evade scouts, and complete missions without copying another game.
      </p>
      <button id="start">BEGIN JOURNEY</button>
    </div>
  </div>

  <div id="hud">
    <div id="mission">
      <b>Active Contract</b><br>
      <span id="objective">Investigate the ruined shrine</span>
    </div>
    <canvas id="minimap" width="170" height="170"></canvas>
    <div id="prompt"></div>
  </div>

  <script>
    "use strict";

    const canvas = document.getElementById("game");
    const ctx = canvas.getContext("2d");
    const mini = document.getElementById("minimap");
    const miniCtx = mini.getContext("2d");
    const promptElement = document.getElementById("prompt");
    const objectiveElement = document.getElementById("objective");

    const WORLD = 2400;
    const keys = {};
    let running = false;
    let cameraX = 0;
    let cameraY = 0;

    const player = {
      x: 1200,
      y: 1300,
      radius: 12,
      speed: 180,
      angle: 0,
      crouching: false,
      concealed: false
    };

    const villages = [
      { x: 850, y: 760, w: 480, h: 310, name: "Pine Gate" },
      { x: 1500, y: 1450, w: 430, h: 290, name: "Autumn Harbor" }
    ];

    const buildings = [
      { x: 900, y: 820, w: 130, h: 75 },
      { x: 1080, y: 830, w: 130, h: 75 },
      { x: 950, y: 950, w: 150, h: 80 },
      { x: 1550, y: 1500, w: 120, h: 72 },
      { x: 1720, y: 1510, w: 130, h: 72 },
      { x: 1580, y: 1630, w: 160, h: 75 }
    ];

    const scouts = [
      { x: 1180, y: 980, patrolX: 1180, patrolY: 980,
        range: 150, angle: 0, detected: 0 },
      { x: 1460, y: 1250, patrolX: 1460, patrolY: 1250,
        range: 145, angle: 1.2, detected: 0 },
      { x: 1760, y: 1700, patrolX: 1760, patrolY: 1700,
        range: 150, angle: 3, detected: 0 }
    ];

    const shrines = [
      { x: 650, y: 430, discovered: false, name: "Stone Shrine" },
      { x: 2050, y: 650, discovered: false, name: "Mountain Shrine" },
      { x: 650, y: 2050, discovered: false, name: "Forest Shrine" }
    ];

    let contractComplete = false;

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = innerWidth * dpr;
      canvas.height = innerHeight * dpr;
      canvas.style.width = innerWidth + "px";
      canvas.style.height = innerHeight + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    addEventListener("resize", resize);
    resize();

    document.getElementById("start").addEventListener("click", () => {
      document.getElementById("title").style.display = "none";
      running = true;
      requestAnimationFrame(loop);
    });

    addEventListener("keydown", e => {
      keys[e.code] = true;
      if (e.code === "KeyC") player.crouching = true;
    });
    addEventListener("keyup", e => {
      keys[e.code] = false;
      if (e.code === "KeyC") player.crouching = false;
    });

    function distance(a, b) {
      return Math.hypot(a.x - b.x, a.y - b.y);
    }

    function hitsBuilding(x, y, radius) {
      return buildings.some(b =>
        x + radius > b.x &&
        x - radius < b.x + b.w &&
        y + radius > b.y &&
        y - radius < b.y + b.h
      );
    }

    function update(dt) {
      if (!running) return;

      let dx = (keys.KeyD ? 1 : 0) - (keys.KeyA ? 1 : 0);
      let dy = (keys.KeyS ? 1 : 0) - (keys.KeyW ? 1 : 0);
      const length = Math.hypot(dx, dy) || 1;
      dx /= length;
      dy /= length;

      let speed = keys.ShiftLeft ? player.speed * 1.65 : player.speed;
      if (player.crouching) speed *= 0.45;

      const oldX = player.x;
      const oldY = player.y;

      player.x += dx * speed * dt;
      player.y += dy * speed * dt;

      player.x = Math.max(player.radius, Math.min(WORLD - player.radius, player.x));
      player.y = Math.max(player.radius, Math.min(WORLD - player.radius, player.y));

      if (hitsBuilding(player.x, player.y, player.radius)) {
        player.x = oldX;
        player.y = oldY;
      }

      if (dx || dy) player.angle = Math.atan2(dy, dx);

      updateScouts(dt);
      updateInteractions();
      updateCamera();
    }

    function updateScouts(dt) {
      for (const scout of scouts) {
        scout.angle += dt * 0.55;
        scout.x = scout.patrolX + Math.cos(scout.angle) * 55;
        scout.y = scout.patrolY + Math.sin(scout.angle) * 55;

        const d = distance(player, scout);
        let visibleRange = scout.range;

        if (player.crouching) visibleRange *= 0.42;
        if (player.concealed) visibleRange *= 0.2;

        if (d < visibleRange) scout.detected += dt;
        else scout.detected = Math.max(0, scout.detected - dt * 0.7);
      }
    }

    function updateInteractions() {
      let text = "";

      for (const shrine of shrines) {
        if (distance(player, shrine) < 65) {
          text = shrine.discovered
            ? "Shrine already discovered"
            : "E — Discover shrine";
          break;
        }
      }

      promptElement.textContent = text;
      promptElement.classList.toggle("visible", !!text);
    }

    function interact() {
      for (const shrine of shrines) {
        if (!shrine.discovered && distance(player, shrine) < 65) {
          shrine.discovered = true;
          objectiveElement.textContent =
            "Shrine discovered — explore the province";
          return;
        }
      }
    }
    addEventListener("keydown", e => {
      if (e.code === "KeyE") interact();
    });

    function updateCamera() {
      cameraX = player.x - innerWidth / 2;
      cameraY = player.y - innerHeight / 2;
      cameraX = Math.max(0, Math.min(WORLD - innerWidth, cameraX));
      cameraY = Math.max(0, Math.min(WORLD - innerHeight, cameraY));
    }

    function drawWorld() {
      ctx.fillStyle = "#6f9061";
      ctx.fillRect(0, 0, WORLD, WORLD);

      // Grass patches
      ctx.fillStyle = "#849d66";
      for (let y = 50; y < WORLD; y += 120) {
        for (let x = 50; x < WORLD; x += 120) {
          const variation = ((x * 13 + y * 7) % 50);
          ctx.fillRect(x + variation / 2, y, 34, 25);
        }
      }

      // Main roads
      ctx.fillStyle = "#b69b72";
      ctx.fillRect(0, 1120, WORLD, 100);
      ctx.fillRect(1120, 0, 100, WORLD);

      // Rivers
      ctx.fillStyle = "#6496a3";
      ctx.beginPath();
      ctx.moveTo(520, 0);
      ctx.bezierCurveTo(700, 650, 360, 1300, 650, WORLD);
      ctx.lineWidth = 130;
      ctx.strokeStyle = "#6496a3";
      ctx.stroke();

      // Villages
      for (const village of villages) {
        ctx.fillStyle = "#d1b98c";
        ctx.fillRect(village.x, village.y, village.w, village.h);
        ctx.fillStyle = "#5f523e";
        ctx.font = "bold 20px Georgia";
        ctx.fillText(village.name, village.x + 20, village.y + 35);
      }

      // Japanese-inspired buildings
      for (const b of buildings) {
        ctx.fillStyle = "#c3a878";
        ctx.fillRect(b.x, b.y, b.w, b.h);
        ctx.fillStyle = "#2f3b30";
        ctx.beginPath();
        ctx.moveTo(b.x - 10, b.y);
        ctx.lineTo(b.x + b.w / 2, b.y - 38);
        ctx.lineTo(b.x + b.w + 10, b.y);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = "#7e5e42";
        ctx.fillRect(b.x + b.w / 2 - 8, b.y + b.h - 34, 16, 34);
      }

      // Shrines
      for (const shrine of shrines) {
        ctx.fillStyle = shrine.discovered ? "#718bb2" : "#d7c16a";
        ctx.fillRect(shrine.x - 18, shrine.y - 8, 36, 16);
        ctx.beginPath();
        ctx.arc(shrine.x, shrine.y - 18, 18, 0, Math.PI * 2);
        ctx.fill();
      }

      // Cherry-like trees
      ctx.fillStyle = "#273f2d";
      for (let i = 0; i < 220; i++) {
        const x = (i * 187 + 90) % WORLD;
        const y = (i * 313 + 140) % WORLD;
        if (Math.abs(x - 620) < 100 && Math.abs(y - 400) < 100) continue;
        ctx.beginPath();
        ctx.arc(x, y, 18 + i % 9, 0, Math.PI * 2);
        ctx.fill();
      }

      // Player
      ctx.save();
      ctx.translate(player.x, player.y);
      ctx.rotate(player.angle);
      ctx.fillStyle = player.crouching ? "#233927" : "#3e5d42";
      ctx.beginPath();
      ctx.arc(0, 0, player.crouching ? 9 : 12, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = "#d6bd82";
      ctx.beginPath();
      ctx.arc(5, 0, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // Scouts
      for (const scout of scouts) {
        ctx.fillStyle = scout.detected > 0.15 ? "#c46d55" : "#4e4b68";
        ctx.beginPath();
        ctx.arc(scout.x, scout.y, 11, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function draw() {
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      ctx.save();
      ctx.translate(-cameraX, -cameraY);
      drawWorld();
      ctx.restore();

      drawMinimap();
    }

    function drawMinimap() {
      miniCtx.fillStyle = "#243728";
      miniCtx.fillRect(0, 0, 170, 170);

      miniCtx.fillStyle = "#c1a476";
      miniCtx.fillRect(0, 79, 170, 8);
      miniCtx.fillRect(79, 0, 8, 170);

      miniCtx.fillStyle = "#6496a3";
      miniCtx.beginPath();
      miniCtx.moveTo(35, 0);
      miniCtx.lineTo(48, 170);
      miniCtx.strokeStyle = "#6496a3";
      miniCtx.lineWidth = 10;
      miniCtx.stroke();

      for (const shrine of shrines) {
        if (shrine.discovered) continue;
        miniCtx.fillStyle = "#e2cb78";
        miniCtx.beginPath();
        miniCtx.arc(
          shrine.x / WORLD * 170,
          shrine.y / WORLD * 170,
          3,
          0,
          Math.PI * 2
        );
        miniCtx.fill();
      }

      miniCtx.fillStyle = "#ffffff";
      miniCtx.beginPath();
      miniCtx.arc(
        player.x / WORLD * 170,
        player.y / WORLD * 170,
        5,
        0,
        Math.PI * 2
      );
      miniCtx.fill();
    }

    let previous = 0;
    function loop(time) {
      const dt = Math.min((time - previous) / 1000 || 0, 0.05);
      previous = time;
      update(dt);
      draw();
      requestAnimationFrame(loop);
    }
  </script>
</body>
</html>
